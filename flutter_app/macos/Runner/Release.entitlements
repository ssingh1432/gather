<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Needed for the Google OAuth callback and any Supabase network call
	     to work under App Sandbox in a release build — this key appears to
	     have been missing entirely (only DebugProfile.entitlements had
	     network.server, which is the wrong direction for outbound client
	     requests). Flagging in case macOS release builds were silently
	     failing all network calls before this. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
